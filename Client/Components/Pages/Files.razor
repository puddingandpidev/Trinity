@page "/files"
@using Client.Services
@using MudBlazor
@using Client.Components.Pages.Dialogs
@using System.Net.Http.Json
@inject FilesApiClient FilesApi
@inject IDialogService DialogService

<style>
    .card  { background-color:#242424; border:1px solid #333; }
    .card-p{ background-color:#242424; border:1px solid #333; padding:16px; }
    .muted { color:#AAAAAA !important; }
    .white { color:white; }
    .lnk   { color:#E87722; text-decoration:none; font-size:0.875rem; }
    .dot   { width:8px;  height:8px;  border-radius:50%; margin-right:6px; }
    .dot-lg{ width:10px; height:10px; border-radius:50%; margin-right:6px; }
    .qa-btn{ text-transform:none !important; justify-content:flex-start !important; }
</style>

<!-- Page Header -->
<div style="margin-bottom:20px;">
    <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">Files</MudText>
@if (_loadError is not null)
{
    <div class="error-banner" role="status">@_loadError</div>
}
    <MudText Typo="Typo.body2" Class="muted">Manage, Store and Share your files</MudText>
</div>

<!-- Stat Cards -->
<MudGrid Spacing="3" Class="mb-4">
    @foreach (var card in _statCards)
    {
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="card" Style="padding:20px;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@card.Icon" Style="color:#888; font-size:2.8rem; margin-right:14px;" />
                    <div>
                        <MudText Typo="Typo.caption" Class="muted">@card.Label</MudText>
                        <MudText Typo="Typo.h4" Style="color:white; font-weight:700;">@card.Value</MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<!-- All Files Table + Right Charts -->
<MudGrid Spacing="3" Class="mb-4">

    <!-- All Files (left, 8 cols) -->
    <MudItem xs="12">
        <MudPaper Class="card" Elevation="0">
            <div style="padding:16px 16px 0; display:flex; justify-content:space-between;
                        align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600;">All Files</MudText>
                <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                    <MudTextField @bind-Value="_search" Placeholder="Search..."
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Style="min-width:140px;" />
                    <MudSelect @bind-Value="_statusFilter" Label="All Status" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="min-width:110px;">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                        <MudSelectItem Value="@("Archived")">Archived</MudSelectItem>
                    </MudSelect>
                    <MudSelect @bind-Value="_typeFilter" Label="All Types" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="min-width:110px;">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        <MudSelectItem Value="@("PDF")">PDF</MudSelectItem>
                        <MudSelectItem Value="@("Excel")">Excel</MudSelectItem>
                        <MudSelectItem Value="@("Word")">Word</MudSelectItem>
                        <MudSelectItem Value="@("Image")">Image</MudSelectItem>
                        <MudSelectItem Value="@("ZIP")">ZIP</MudSelectItem>
                        <MudSelectItem Value="@("Text")">Text</MudSelectItem>
                        <MudSelectItem Value="@("PowerPoint")">PowerPoint</MudSelectItem>
                        <MudSelectItem Value="@("MP4")">MP4</MudSelectItem>
                    </MudSelect>
                    <MudSelect @bind-Value="_modifiedFilter" Label="All Modified" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="min-width:120px;">
                        <MudSelectItem Value="@("All")">All</MudSelectItem>
                        <MudSelectItem Value="@("Today")">Today</MudSelectItem>
                        <MudSelectItem Value="@("Week")">This Week</MudSelectItem>
                        <MudSelectItem Value="@("Month")">This Month</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               Style="text-transform:none;"
                               OnClick="OpenExportFileDialog">Export</MudButton>
                </div>
            </div>
            <MudTable T="FileModel" Items="@_files" Dense="true" Hover="true"
                      Elevation="0" Style="background-color:transparent;">
                <HeaderContent>
                    <MudTh Class="muted">File Name</MudTh>
                    <MudTh Class="muted">Type</MudTh>
                    <MudTh Class="muted">Size</MudTh>
                    <MudTh Class="muted">Location</MudTh>
                    <MudTh Class="muted">Uploaded By</MudTh>
                    <MudTh Class="muted">Modified</MudTh>
                    <MudTh Class="muted"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="color:white">@context.Name</MudTd>
                    <MudTd Class="muted">@context.Type</MudTd>
                    <MudTd Class="muted">@context.Size</MudTd>
                    <MudTd Class="muted">@context.Location</MudTd>
                    <MudTd Class="muted">@context.UploadedBy</MudTd>
                    <MudTd Class="muted">@context.Modified</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       title="Delete this file from the team server"
                                       OnClick="@(() => DeleteAsync(context.Name))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted" Style="text-align:center; padding:20px;">No Files To Display</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- Right Column: Storage + Type Charts -->

</MudGrid>

<!-- Recent Uploads + Quick Actions -->
<MudGrid Spacing="3">

    <!-- Recent Uploads (left, 8 cols) -->
    <MudItem xs="12" md="8">
        <MudPaper Class="card" Elevation="0">
            <div style="padding:16px 16px 0;">
                <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600;">Recent Uploads</MudText>
            </div>
            <MudTable T="RecentUploadModel" Items="@_recentUploads" Dense="true" Hover="true"
                      Elevation="0" Style="background-color:transparent;">
                <HeaderContent>
                    <MudTh Class="muted">File Name</MudTh>
                    <MudTh Class="muted">Size</MudTh>
                    <MudTh Class="muted">Time</MudTh>
                    <MudTh Class="muted">Uploaded By</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="white" style="font-size:0.85rem;">@context.Name</div>
                        <div class="muted" style="font-size:0.75rem;">@context.Path</div>
                    </MudTd>
                    <MudTd Class="muted">@context.Size</MudTd>
                    <MudTd Class="muted">@context.Time</MudTd>
                    <MudTd Class="muted">@context.UploadedBy</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="muted" Style="text-align:center; padding:20px;">No Recent Uploads</MudText>
                </NoRecordsContent>
            </MudTable>
            <div style="padding:12px 16px; border-top:1px solid #333;">
                <a class="lnk" href="#">View Uploads →</a>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Quick Actions (right, 4 cols) -->
    <MudItem xs="12" md="4">
        <MudPaper Class="card-p" Elevation="0">
            <MudText Typo="Typo.subtitle1" Style="color:white; font-weight:600; margin-bottom:12px;">Quick Actions</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.Upload"
                               OnClick="OpenUploadFileDialog">Upload File</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.Security"
                               OnClick="OpenScanFileDialog">Scan File</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="OpenDownloadFileDialog">Download</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.Share"
                               OnClick="OpenShareFileDialog">Share File</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.CreateNewFolder"
                               OnClick="OpenCreateNewFolderDialog">New Folder</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="OpenViewFilesDialog">View Files</MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                               Class="qa-btn" StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="OpenBulkUploadDialog">Bulk Upload</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private string _search         = string.Empty;
    private string _statusFilter   = "All";
    private string _typeFilter     = "All";
    private string _modifiedFilter = "All";

    private record StatCard(string Label, string Value, string Icon);
    private StatCard[] _statCards =
    {
        // Only the file count is knowable: the server stores names, not sizes, folders or
        // upload/download counters. The other four cards were permanent zeros.
        new("Total Files", "0", Icons.Material.Outlined.Description),
    };

    private record FileModel(
        string Name, string Type, string Size,
        string Location, string UploadedBy, string Modified);
    private List<FileModel> _files = new();

    private record RecentUploadModel(
        string Name, string Path, string Size,
        string Time, string UploadedBy);
    private List<RecentUploadModel> _recentUploads = new();

    protected override async Task OnInitializedAsync()
    => await LoadFilesAsync();

    private string? _loadError;

    /// <summary>Deletes a stored file through the API, then reloads the listing.</summary>
    private async Task DeleteAsync(string fileName)
    {
        try
        {
            var removed = await FilesApi.DeleteAsync(fileName);
            _loadError = removed ? null : $"'{fileName}' was already gone from the team server.";
            await LoadFilesAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            _loadError = ServerDown.Is(exception) ? ServerDown.Message : $"Could not delete '{fileName}': {exception.Message}";
        }
    }

    private async Task LoadFilesAsync()
    {
        try
        {
            var list = await FilesApi.ListAsync();
            if (list is null) return;
            _files = list.Select(f => new FileModel(f, "—", "—", "—", "—", "—")).ToList();
            _statCards[0] = _statCards[0] with { Value = list.Count.ToString() };
            _loadError = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            _loadError = ServerDown.Is(exception) ? ServerDown.Message : $"Could not load files: {exception.Message}";
        }
    }

    private record LegendItem(string Label, string Color);
    private LegendItem[] _fileTypeLegend =
    {
        new("Documents", "#4CAF50"),
        new("Images",    "#2196F3"),
        new("Archives",  "#E87722"),
        new("Videos",    "#F44336"),
        new("Others",    "#9C27B0"),
    };

    private static readonly DialogOptions _dialogOpts = new()
    {
        CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true
    };

    private async Task OpenUploadFileDialog()
    {
        var dialog = await DialogService.ShowAsync<UploadFileDialog>(string.Empty, new(), _dialogOpts);
        var result = await dialog.Result;

        // Only reload when the dialog actually uploaded something, so a cancel cannot look
        // like a refresh that silently did nothing.
        if (result is { Canceled: false })
        {
            await LoadFilesAsync();
        }
    }
    private Task OpenScanFileDialog()
        => DialogService.ShowAsync<ScanFileDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenDownloadFileDialog()
        => DialogService.ShowAsync<DownloadFileDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenShareFileDialog()
        => DialogService.ShowAsync<ShareFileDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenCreateNewFolderDialog()
        => DialogService.ShowAsync<CreateNewFolderDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenViewFilesDialog()
        => DialogService.ShowAsync<ViewFilesDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenBulkUploadDialog()
        => DialogService.ShowAsync<BulkUploadDialog>(string.Empty, new(), _dialogOpts);
    private Task OpenExportFileDialog()
        => DialogService.ShowAsync<ExportFileDialog>(string.Empty, new(), _dialogOpts);
}

