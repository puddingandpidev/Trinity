@page "/clients"
@* A guessed /index is a common first URL; land it on the client list instead of a 404. *@
@page "/index"
@layout TrinityLayout
@using Client.Components.UI

<PageTitle>Trinity · Clients</PageTitle>

<div class="clients-page">

    @if (_loadError is not null || _taskLoadError is not null)
    {
        <div class="error-banner" role="status">
            @if (Connection.BaseAddress is null)
            {
                <span>Connect to a TeamServer from the Login page before viewing clients.</span>
                <button type="button" class="export-btn" @onclick="GoToLogin">Go to Login</button>
            }
            else
            {
                @if (_loadError is not null)
                {
                    <span>@_loadError</span>
                    <button type="button" class="export-btn" @onclick="LoadAgentsAsync">Retry agents</button>
                }
                @if (_taskLoadError is not null)
                {
                    <span>@_taskLoadError</span>
                    <button type="button" class="export-btn" @onclick="LoadTasksAsync">Retry task history</button>
                }
            }
        </div>
    }

    <section class="header">
        <h1>Clients</h1>
        <p class="subtitle">Manage and monitor all connected clients</p>
    </section>

    <section class="stats-row">
        @foreach (var stat in BuildStats())
        {
            <div class="stat-card t-card">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        @((MarkupString)stat.Icon)
                    </svg>
                </div>
                <div class="stat-body">
                    <div class="label">@stat.Label</div>
                    <div class="value">@stat.Value</div>
                </div>
            </div>
        }
    </section>

    <div class="clients-grid">

        <div class="col-main">

            <section class="table-section t-card">
                <div class="table-toolbar">
                    <h2>All Clients</h2>
                    <div class="toolbar-controls">
                        <div class="search-field">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            <input type="text" placeholder="Search..." @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
                        </div>
                        <select class="filter-select" @bind="_statusFilter" @bind:after="ResetPage">
                            <option>All Status</option>
                            <option>Online</option>
                            <option>Offline</option>
                        </select>
                        <select class="filter-select" @bind="_osFilter" @bind:after="ResetPage">
                            <option>All Architectures</option>
                            <option>x64</option>
                            <option>x86</option>
                        </select>
                        <button type="button" class="export-btn" @onclick="ExportClients">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                            Export
                        </button>
                        <button type="button" class="export-btn" @onclick="RefreshDataAsync">Refresh</button>
                    </div>
                </div>

                <table class="client-table">
                    <thead>
                        <tr>
                            <th>Client Name</th>
                            <th>IP Address</th>
                            <th>Architecture</th>
                            <th>Status</th>
                            <th>Last Seen</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PageItems.Any())
                        {
                            <tr><td colspan="6" class="empty-row">@( _loadError ?? (_isLoading ? "Loading agents from TeamServer..." : "No clients match your filters."))</td></tr>
                        }
                        @foreach (var row in PageItems)
                        {
                            <tr class="@(row == _selected ? "selected" : null)" tabindex="0" role="button"
                                aria-pressed="@(row == _selected ? "true" : "false")"
                                @onclick="() => SelectRow(row)"
                                @onkeydown="e => RowKey(e, row)">
                                <td>@row.Name</td>
                                <td>@row.Ip</td>
                                <td>@row.Os</td>
                                <td>
                                    <span class="status-dot status-@StatusColor(row.Status)"></span>
                                    @row.Status
                                </td>
                                <td>@row.LastSeen</td>
                                <td>@row.User</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="table-footer">
                    <span class="showing">@ShowingText</span>
                    <div class="pagination">
                        <button type="button" class="page-btn" disabled="@(CurrentPage <= 1)" @onclick="() => GoToPage(CurrentPage - 1)">‹</button>
                        @for (var p = 1; p <= TotalPages; p++)
                        {
                            var pg = p;
                            <button type="button" class="page-btn @(pg == CurrentPage ? "active" : null)" @onclick="() => GoToPage(pg)">@pg</button>
                        }
                        <button type="button" class="page-btn" disabled="@(CurrentPage >= TotalPages)" @onclick="() => GoToPage(CurrentPage + 1)">›</button>
                    </div>
                </div>
            </section>

            <section class="timeline-section t-card">
                <h2>Client Activity Timeline</h2>
                <ul class="timeline">
                    @if (_timeline.Count == 0 && _taskLoadError is null)
                    {
                        <li class="timeline-item"><span class="timeline-text">No task history is available from TeamServer.</span></li>
                    }
                    @foreach (var ev in _timeline)
                    {
                        <li class="timeline-item">
                            <span class="timeline-time">@ev.When</span>
                            <span class="timeline-dot status-@ev.Color"></span>
                            <span class="timeline-text">@ev.Text</span>
                        </li>
                    }
                </ul>
            </section>

        </div>

        <div class="col-side">


            <section class="panel-os t-card">
                <div class="panel-head">
                    <h2>Client Architecture Distribution</h2>
                </div>
                <div class="os-body">
                    <div class="donut">
                        <div class="donut-ring" style="background: conic-gradient(@DonutGradient());"></div>
                        <div class="donut-center">
                            <span class="donut-num">@_clients.Count</span>
                            <span class="donut-label">Total</span>
                        </div>
                    </div>
                    <ul class="os-legend">
                        @foreach (var os in BuildOsBreakdown())
                        {
                            <li>
                                <span class="legend-dot status-@os.Color"></span>
                                <span class="legend-label">@os.Name</span>
                                <span class="legend-value">@os.Count (@os.Percent%)</span>
                            </li>
                        }
                    </ul>
                </div>
            </section>

            <section class="panel-actions t-card">
                <div class="panel-head">
                    <h2>Quick Actions</h2>
                </div>
                <div class="actions-grid">
                    @foreach (var a in Actions)
                    {
                        <button type="button" class="action-btn" disabled="@(a.Label is not ("View All Clients" or "Execute Job" or "Remote Shell"))" title="@(a.Label is ("View All Clients" or "Execute Job" or "Remote Shell") ? null : "TeamServer does not support this action from the Clients page.")" @onclick="a.OnClick">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                @((MarkupString)a.Icon)
                            </svg>
                            <span>@a.Label</span>
                        </button>
                    }
                </div>
            </section>

        </div>

    </div>
</div>

@if (_toast is not null)
{
    <div class="toast">@_toast</div>
}

@if (_showAdd)
{
    <Modal Title="Add New Client" Subtitle="A client appears when its agent checks in" IconName="btn-plus.svg"
           CloseOnBackdrop="false" FootNote="Agents register themselves; this form is kept for parity."
           OnClose="CloseModals">
        <ChildContent>
            <label class="modal-label" for="add-client-name">Client Name (auto-assigned)</label>
            <input id="add-client-name" class="modal-input" value="@_form.Name" readonly />
            <label class="modal-label" for="add-client-ip">IP Address</label>
            <input id="add-client-ip" class="modal-input" @bind="_form.Ip" placeholder="192.168.1.20" />
            <label class="modal-label" for="add-client-os">Operating System</label>
            <select id="add-client-os" class="modal-input" @bind="_form.Os">
                <option>Windows 10</option>
                <option>Windows 11</option>
                <option>Ubuntu 22.04</option>
                <option>macOS 14</option>
            </select>
            <label class="modal-label" for="add-client-user">User</label>
            <input id="add-client-user" class="modal-input" @bind="_form.User" placeholder="Jane Doe" />
        </ChildContent>
        <Footer>
            <button type="button" class="btn-ghost" @onclick="CloseModals">Cancel</button>
            <button type="button" class="btn-primary" @onclick="AddClient">Add Client</button>
        </Footer>
    </Modal>
}

@if (_showAnnounce)
{
    <Modal Title="Send Announcement" Subtitle="Broadcast to every connected client" IconName="lucide-users.svg"
           CloseOnBackdrop="false" FootNote="The message is stored with the task history."
           OnClose="CloseModals">
        <ChildContent>
            <label class="modal-label" for="announce-text">Message (broadcast to all clients)</label>
            <textarea id="announce-text" class="modal-input" rows="4" @bind="_announceText" placeholder="Type your announcement..."></textarea>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-ghost" @onclick="CloseModals">Cancel</button>
            <button type="button" class="btn-primary" @onclick="SendAnnouncement">Send</button>
        </Footer>
    </Modal>
}

@if (_showExecute)
{
    <Modal Title="Execute Job" Subtitle="Queue a command on the selected client" IconName="nav-agents.svg"
           CloseOnBackdrop="false" FootNote="The agent runs the command on its next check-in."
           OnClose="CloseModals">
        <ChildContent>
            <label class="modal-label" for="job-target">Target</label>
            <select id="job-target" class="modal-input" @bind="_jobTargetId">
                @foreach (var client in _clients)
                {
                    <option value="@client.AgentId">@client.Name</option>
                }
            </select>

            <label class="modal-label" for="job-name">Job</label>
            <select id="job-name" class="modal-input" @bind="_jobName">
                @foreach (var job in _jobCatalogue)
                {
                    <option value="@job.Name">@job.Name</option>
                }
            </select>

            @if (JobLabel1 is not null)
            {
                <label class="modal-label" for="job-arg-1">@JobLabel1</label>
                <input id="job-arg-1" class="modal-input" @bind="_jobArg" />
            }
            @if (JobLabel2 is not null)
            {
                <label class="modal-label" for="job-arg-2">@JobLabel2</label>
                <input id="job-arg-2" class="modal-input" @bind="_jobArg2" />
            }
            @if (JobLabel3 is not null)
            {
                <label class="modal-label" for="job-arg-3">@JobLabel3</label>
                <input id="job-arg-3" class="modal-input" @bind="_jobArg3" />
            }

            <span class="modal-label">Execution Options</span>
            <div class="radio-row">
                <button type="button" class="radio-pill @(_jobImmediate ? "on" : null)" aria-pressed="@_jobImmediate" @onclick="() => _jobImmediate = true">
                    <span class="radio-dot"></span> Immediate
                </button>
                <button type="button" class="radio-pill @(!_jobImmediate ? "on" : null)" aria-pressed="@(!_jobImmediate)" @onclick="() => _jobImmediate = false">
                    <span class="radio-dot"></span> Scheduled
                </button>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-ghost" @onclick="CloseModals">Cancel</button>
            <button type="button" class="btn-primary" @onclick="RunJob">Confirm</button>
        </Footer>
    </Modal>
}

@if (_showShell)
{
    <Modal Title="Remote Shell" Subtitle="@(_selected?.Name ?? "none selected")" IconName="lucide-terminal.svg"
           CloseOnBackdrop="false" FootNote="Commands are queued on the selected client."
           OnClose="CloseModals">
        <ChildContent>
            <div class="shell-output">
                @foreach (var line in _shellLog)
                {
                    <div class="shell-line">@line</div>
                }
            </div>
            <div class="shell-input-row">
                <span class="shell-prompt">&gt;</span>
                <input id="shell-command" class="modal-input" @bind="_shellInput" @onkeydown="ShellKey" placeholder="whoami" aria-label="Command" />
                <button type="button" class="btn-primary" @onclick="RunShell">Run</button>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-ghost" @onclick="CloseModals">Close</button>
        </Footer>
    </Modal>
}
