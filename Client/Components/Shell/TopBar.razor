@using Client.Components.UI
@using Client.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage Session
@inject TeamServerConnection Connection
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject AuthTokenStore TokenStore

<header class="ts-topbar">
    <div class="ts-topbar__brand">
        <span class="ts-topbar__logo"><img src="img/shell/shell-logo.png" alt="" width="20" height="20" /></span>
        <span class="ts-topbar__word">TRINITY</span>
    </div>

    @if (Admin && _user?.IsAdmin == true)
    {
        <span class="ts-topbar__badge">ADMIN CONSOLE</span>
    }

    @* TODO: point Help at the docs *@
    <button type="button" class="ts-topbar__help">Help</button>

    <div class="ts-topbar__right">
        @if (Admin)
        {
            <a class="ts-topbar__back" href="logs"><Icon Name="lucide-arrow-left.svg" Size="13" /> Back to workspace</a>
        }
        else
        {
            <span class="ts-topbar__server" title="@(Connected ? "Team server reachable" : "Team server not reachable")">
                <span class="ts-dot @(Connected ? null : "is-down")"></span>@ServerLabel
            </span>
        }

        @if (_user is not null)
        {
            @if (_user.IsAdmin && !Admin)
            {
                <a class="ts-topbar__user" href="campaigns" title="Open the admin console">
                    <Icon Name="topbar-user.svg" Size="14" /><b>@_user.Name</b><span>@(_user.IsAdmin ? "Admin" : "Operator")</span>
                </a>
            }
            else
            {
                <span class="ts-topbar__user"><Icon Name="topbar-user.svg" Size="14" /><b>@_user.Name</b><span>@(_user.IsAdmin ? "Admin" : "Operator")</span></span>
            }
        }

        <button type="button" class="ts-topbar__logout" title="Sign out" @onclick="SignOutAsync"><Icon Name="topbar-logout.svg" Size="15" /></button>
    </div>
</header>

@code {
    [Parameter] public bool Admin { get; set; }
    [Parameter] public bool Connected { get; set; }
    [Parameter] public EventCallback<ShellUser> OnUserLoaded { get; set; }

    private ShellUser? _user;

    private string ServerLabel => Connection.BaseAddress is { } uri ? $"{uri.Host}:{uri.Port}" : "not connected";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = GuardAsync();

    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? GuardAsync() : Task.CompletedTask;

    /// <summary>
    /// Loads the signed-in operator and applies the route guard.
    /// </summary>
    /// <remarks>
    /// This used to run only on the first render, so a client-side navigation into an admin route
    /// was never re-checked: an operator could press the sidebar's "Operators" link and be served
    /// the roster with Edit / Reset Password / Remove in front of them. The subscription above
    /// re-runs it for every navigation; the API is still the place that must refuse (see the role
    /// model in REPORT §6.1), but the page should not paint what it will not allow.
    /// </remarks>
    private async Task GuardAsync()
    {
        try
        {
            var stored = await Session.GetAsync<ShellUser>(ShellUser.StorageKey);
            _user = stored is { Success: true, Value: { } user } ? user : null;
        }
        catch (Exception)
        {
            _user = null;
        }

        if (_user is null)
        {
            Nav.NavigateTo("login");
            return;
        }

        // Operators may open campaign pages (they are assigned to campaigns); only the
        // /admin/* console is admin-only.
        if (Admin && !_user.IsAdmin &&
            Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("campaigns");
            return;
        }

        StateHasChanged();
        await OnUserLoaded.InvokeAsync(_user);
    }

    private async Task SignOutAsync()
    {
        await Session.DeleteAsync(ShellUser.StorageKey);
        await TokenStore.ClearAsync();
        Nav.NavigateTo("login");
    }
}
